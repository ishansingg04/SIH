# MediKiosk Environment Configuration Template
# Copy this file to .env and configure for local or staging development.
# NEVER commit .env to version control!

# Application Environment (local | staging | production)
APP_ENV=local

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://medikiosk:medikiosk@localhost:5432/medikiosk

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-local-secret-key-at-least-32-chars
JWT_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# Speech & AI Providers
GROQ_API_KEY=
GEMINI_API_KEY=
WHISPER_PROVIDER_MODE=mock
AI_PROVIDER_MODE=mock # mock | groq | openai | gemini
WEB_SPEECH_FALLBACK=true

# AYUSH Intake Configuration
AYUSH_INTAKE_ENABLED=true

# Object Storage (S3 / MinIO compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=local-access-key
STORAGE_SECRET_KEY=local-secret-key
STORAGE_BUCKET=medikiosk-private
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app

# Observability
LOG_LEVEL=INFO
